{
  "name": "integration-fastfood",
  "version": "2.0.0",
  "description": "Integration de la maquette Figma avec Tailwind CSS",
  "scripts": {
    "dev": "npx tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "build": "npx tailwindcss -i ./src/input.css -o ./src/output.css --minify"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.12",
    "postcss": "^8.4.35",
    "autoprefixer": "^10.4.17"
  }
}
